# Supabase (public, browser-safe values: Project Settings > API Keys > "publishable").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to "local" to run against browser storage + fixture data instead of Supabase (used by the e2e tests).
# VITE_DATA_BACKEND=local

# Server-side only (Edge Function secrets), NEVER a VITE_ var:
# GOOGLE_PLACES_API_KEY=
